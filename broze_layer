from pyspark.sql.functions import current_timestamp

# Define paths and table names
source_path = "dbfs:/FileStore/data/raw_ecommerce_sales.csv"
bronze_table = "ecommerce_db.bronze_sales"

# Read Raw CSV
raw_df = spark.read.format("csv").option("header", "true").option("inferSchema", "true").load(source_path)

# Add ingestion timestamp
bronze_df = raw_df.withColumn("ingestion_timestamp", current_timestamp())

# Write to Bronze layer as Delta Table
bronze_df.write.format("delta").mode("append").saveAsTable(bronze_table)

print("Data successfully ingested into Bronze layer.")
